{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Container Manage Center",
  "bundle": {
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "legal/LICENSE.txt",
      "../README.md": "docs/README.md",
      "../INSTALL.md": "docs/INSTALL.md",
      "../USER_GUIDE.md": "docs/USER_GUIDE.md",
      "../docs/legal/THIRD_PARTY_NOTICES-windows.md": "legal/THIRD_PARTY_NOTICES.md",
      "../docs/legal/LICENSE_OVERVIEW.md": "legal/LICENSE_OVERVIEW.md",
      "../docs/legal/COPYRIGHT.md": "legal/COPYRIGHT.md",
      "../docs/legal/DISTRIBUTION_COMPLIANCE.md": "legal/DISTRIBUTION_COMPLIANCE.md",
      "../packaging/windows/licenses/WebView2Loader.LICENSE.txt": "legal/WebView2Loader.LICENSE.txt",
      "../packaging/windows/licenses/mingw-w64-runtime.copyright": "legal/mingw-w64-runtime.copyright.txt",
      "../packaging/windows/licenses/gcc-mingw-w64.copyright": "legal/gcc-mingw-w64.copyright.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Spanish",
          "French",
          "Italian",
          "Portuguese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Container Manage Center"
      }
    }
  }
}
