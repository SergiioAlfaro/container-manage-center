{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "docker-control-center",
  "mainBinaryName": "docker-control-center",
  "version": "1.4.0",
  "identifier": "org.dockercontrolcenter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Docker Control Center",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Administración gráfica de Docker Engine, local y remoto por SSH",
    "longDescription": "Docker Control Center permite administrar contenedores, imágenes, redes, volúmenes, directorios vinculados y proyectos Docker Compose desde una interfaz gráfica, en este equipo y en servidores remotos por SSH, mostrando en todo momento las operaciones reales ejecutadas sobre Docker Engine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "section": "admin",
        "desktopTemplate": "../packaging/docker-control-center.desktop",
        "recommends": [
          "openssh-client"
        ],
        "files": {
          "/usr/share/doc/docker-control-center/copyright": "../packaging/copyright",
          "/usr/share/doc/docker-control-center/README.md": "../README.md",
          "/usr/share/doc/docker-control-center/INSTALL.md": "../INSTALL.md",
          "/usr/share/doc/docker-control-center/USER_GUIDE.md": "../USER_GUIDE.md",
          "/usr/share/doc/docker-control-center/THIRD-PARTY.md": "../packaging/THIRD-PARTY.md"
        },
        "changelog": "../CHANGELOG.md"
      }
    },
    "publisher": "Docker Control Center",
    "copyright": "Copyright © 2026 Docker Control Center. Licencia GPL-3.0-or-later (provisional).",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE"
  }
}
