{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "container-manage-center",
  "mainBinaryName": "container-manage-center",
  "version": "1.10.0",
  "identifier": "org.containermanagecenter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Container Manage Center",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Administración gráfica de Docker Engine, local y remoto por SSH",
    "longDescription": "Container Manage Center (CMC) permite administrar contenedores, imágenes, redes, volúmenes, directorios vinculados y proyectos Docker Compose desde una interfaz gráfica, en este equipo y en servidores remotos por SSH, mostrando en todo momento las operaciones reales ejecutadas sobre Docker Engine. Es un proyecto independiente, no afiliado ni respaldado por Docker, Inc.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "section": "admin",
        "desktopTemplate": "../packaging/container-manage-center.desktop",
        "recommends": [
          "openssh-client"
        ],
        "conflicts": [
          "docker-control-center"
        ],
        "replaces": [
          "docker-control-center"
        ],
        "files": {
          "/usr/share/doc/container-manage-center/copyright": "../packaging/copyright",
          "/usr/share/doc/container-manage-center/LICENSE": "../LICENSE",
          "/usr/share/doc/container-manage-center/README.md": "../README.md",
          "/usr/share/doc/container-manage-center/INSTALL.md": "../INSTALL.md",
          "/usr/share/doc/container-manage-center/USER_GUIDE.md": "../USER_GUIDE.md",
          "/usr/share/doc/container-manage-center/MIGRATION.md": "../docs/MIGRATION-CMC.md",
          "/usr/share/doc/container-manage-center/THIRD_PARTY_NOTICES.md": "../docs/legal/THIRD_PARTY_NOTICES.md",
          "/usr/share/doc/container-manage-center/LICENSE_OVERVIEW.md": "../docs/legal/LICENSE_OVERVIEW.md",
          "/usr/share/doc/container-manage-center/COPYRIGHT.md": "../docs/legal/COPYRIGHT.md",
          "/usr/share/doc/container-manage-center/DISTRIBUTION_COMPLIANCE.md": "../docs/legal/DISTRIBUTION_COMPLIANCE.md"
        },
        "changelog": "../CHANGELOG.md"
      }
    },
    "publisher": "Container Manage Center",
    "copyright": "Copyright © 2026 Sergio Alfaro Lorite. Licencia GPL-3.0-or-later.",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE"
  }
}
