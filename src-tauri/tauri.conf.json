{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "docker-control-center",
  "mainBinaryName": "docker-control-center",
  "version": "0.1.0",
  "identifier": "org.dockercontrolcenter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Docker Control Center",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Administración gráfica de Docker Engine",
    "longDescription": "Docker Control Center permite administrar contenedores, imágenes, redes, volúmenes, directorios vinculados y proyectos Docker Compose desde una interfaz gráfica, mostrando en todo momento las operaciones reales ejecutadas sobre Docker Engine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "section": "admin",
        "desktopTemplate": "../packaging/docker-control-center.desktop"
      }
    }
  }
}
